# Backend example environment for local development
# Copy to .env.dev or .env and replace secrets before real deployment.

ENV=development
GIN_MODE=debug
PORT=8080
LOG_DIR=./log
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
# Absolute path to a readable GeoLite2 City MMDB. Required in production for city-level IP location.
GEOIP_DB_PATH=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
VITE_API_URL=/api/v1
ATOMAN_FRONTEND_VERSION=0.0.2
AUTH_CODE_SECRET=change-me-to-a-long-random-secret
TURNSTILE_SECRET_KEY=

# Feed workers. The renderer fallback remains disabled until URL is set.
RSS_CRON_ENABLED=true
RSS_CRON_STARTUP_DELAY=60s
RSS_CRON_INTERVAL=15m
FULLTEXT_WORKER_ENABLED=true
FULLTEXT_WORKER_STARTUP_DELAY=120s
FULLTEXT_WORKER_INTERVAL=2m
FULLTEXT_WORKER_BATCH_SIZE=100
FULLTEXT_WORKER_CONCURRENCY=4
FULLTEXT_RENDERER_URL=
FULLTEXT_RENDERER_TOKEN=
# Set both values to proxy signed reader images through the backend/CDN.
# Use at least 32 random characters for the signing secret.
FEED_IMAGE_PROXY_PUBLIC_URL=
FEED_IMAGE_PROXY_SECRET=

# IndexNow is disabled when INDEXNOW_KEY is empty.
INDEXNOW_KEY=
INDEXNOW_SITE_URL=https://www.atoman.org
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# OAuth providers are enabled only when their required values are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

DATABASE_TYPE=postgres
POSTGRES_USER=atoman
POSTGRES_PASSWORD=atoman_secret
POSTGRES_DB=atoman_dev
DATABASE_URL=postgres://atoman:atoman_secret@localhost:5432/atoman_dev?sslmode=disable&TimeZone=Asia/Shanghai

STORAGE_TYPE=local
PUBLIC_UPLOADS_BASE_URL=http://localhost:8080/uploads
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=atoman-dev
# Dedicated source bucket for album imports; defaults to S3_BUCKET when empty.
MUSIC_SOURCE_BUCKET=
# Dedicated playback bucket; defaults to S3_BUCKET when empty.
MUSIC_PLAYBACK_BUCKET=
# Public custom-domain prefix used for playback objects.
MUSIC_PLAYBACK_URL_PREFIX=http://localhost:9100/atoman-dev
# Stable identifier for the independent album-import worker. Empty uses hostname.
MUSIC_IMPORT_WORKER_ID=
# Delay between idle music-import worker passes.
MUSIC_IMPORT_WORKER_POLL_INTERVAL=5s
S3_URL_PREFIX=http://localhost:9100/atoman-dev
DM_S3_BUCKET=atoman-dm-dev
DM_LOCAL_DIR=.data/dm
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

RESEND_API_KEY=
FROM_EMAIL=
OWNER_USERNAME=owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me
