[Unit]
ConditionPathExists=/etc/atoman/papers/SECURITY_REVIEW_APPROVED
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3
Description=Atoman Papers operator-only signed TeX release publication
After=atoman-papers-environment.service
Requires=atoman-papers-environment.service

[Service]
Type=oneshot
User=atoman-papers-publisher
Group=atoman-papers-publish
UMask=0077
Environment=PAPERS_SERVICE_ENABLE=1
LoadCredential=papers-publisher.json:/etc/atoman/papers/publisher.json
ExecStart=/opt/atoman/papers/bin/papers-service publish-release
TimeoutStartSec=15min
MemoryMax=384M
TasksMax=48
LimitNOFILE=1024
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
IPAddressDeny=any
IPAddressAllow=localhost

# No Install section: never publish or load a signing key automatically.
