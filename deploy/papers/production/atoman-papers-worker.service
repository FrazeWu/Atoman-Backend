[Unit]
ConditionPathExists=/etc/atoman/papers/SECURITY_REVIEW_APPROVED
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3
Description=Atoman Papers dedicated queue worker
After=atoman-papers-launcher.service
Requires=atoman-papers-launcher.service

[Service]
Type=exec
User=atoman-papers-worker
Group=atoman-papers-worker
UMask=0077
Environment=PAPERS_SERVICE_ENABLE=1
LoadCredential=papers-worker.json:/etc/atoman/papers/worker.json
ExecStart=/opt/atoman/papers/bin/papers-service worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryMax=256M
TasksMax=64
LimitNOFILE=1024
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
