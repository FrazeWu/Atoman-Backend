[Unit]
Description=Isolated Atoman Papers CRDT runtime
ConditionPathExists=/etc/atoman/papers/CRDT_RUNTIME_APPROVED
Requires=atoman-papers-crdt.socket
After=atoman-papers-crdt.socket
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
DynamicUser=yes
UMask=0077
ExecStart=/opt/atoman-papers-crdt/bin/papers-crdt-worker --node=/usr/bin/node --runtime=/opt/atoman-papers-crdt/runtime/cli.mjs --client-user=atoman
Restart=on-failure
RestartSec=2
TimeoutStopSec=12
MemoryMax=512M
TasksMax=48
CPUQuota=100%
LimitNOFILE=128
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
TemporaryFileSystem=/run:ro
InaccessiblePaths=-/etc/atoman -/opt/atoman -/var/lib/atoman -/var/log/atoman -/srv -/mnt -/media
