[Unit]
ConditionPathExists=/etc/atoman/papers/SECURITY_REVIEW_APPROVED
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3
Description=Atoman Papers environment immutable publication gateway

[Service]
Type=exec
User=atoman-papers-env
Group=atoman-papers-publish
UMask=0077
Environment=PAPERS_SERVICE_ENABLE=1
LoadCredential=papers-environment-gateway.json:/etc/atoman/papers/environment-gateway.json
RuntimeDirectory=atoman-papers-environment
RuntimeDirectoryMode=0750
StateDirectory=atoman-papers-environment
StateDirectoryMode=0700
ExecStart=/opt/atoman/papers/bin/papers-service environment-gateway
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryMax=384M
TasksMax=64
LimitNOFILE=1024
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
