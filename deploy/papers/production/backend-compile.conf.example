# Install as an atoman-backend.service drop-in ONLY after acceptance.
[Unit]
Wants=atoman-papers-snapshot.service atoman-papers-launcher.service
After=atoman-papers-snapshot.service atoman-papers-launcher.service
[Service]
Environment=PAPERS_COMPILE_ENABLE=1
SupplementaryGroups=atoman-papers-api
LoadCredential=papers-api.json:/etc/atoman/papers/api.json
RuntimeDirectory=atoman-papers-queue
RuntimeDirectoryMode=0700
