[Unit]
ConditionPathExists=/etc/atoman/papers/PRIVATE_STORAGE_APPROVED
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3
Description=Atoman Papers snapshot immutable publication gateway

[Service]
Type=exec
User=atoman-papers-snapshot
Group=atoman-papers-api
UMask=0077
Environment=PAPERS_SERVICE_ENABLE=1
LoadCredential=papers-snapshot-gateway.json:/etc/atoman/papers/snapshot-gateway.json
RuntimeDirectory=atoman-papers-snapshot
RuntimeDirectoryMode=0750
StateDirectory=atoman-papers-snapshot
StateDirectoryMode=0700
ExecStart=/opt/atoman/papers/bin/papers-service snapshot-gateway
ExecStartPost=/usr/bin/timeout 45 /bin/sh -c 'until test -S /run/atoman-papers-snapshot/publish.sock; do sleep 1; done'
TimeoutStartSec=60
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryMax=384M
TasksMax=64
LimitNOFILE=1024
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
